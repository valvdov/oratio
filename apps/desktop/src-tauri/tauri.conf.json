{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oratio",
  "version": "0.1.0",
  "identifier": "dev.valvdov.oratio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Oratio",
        "url": "index.html",
        "width": 780,
        "height": 580,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "visible": false
      },
      {
        "label": "pill",
        "title": "Oratio pill",
        "url": "pill.html",
        "width": 330,
        "height": 64,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "resizable": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
